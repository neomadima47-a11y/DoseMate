<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/dark_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Schedule Medication &amp; Daily Alarms"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Set start date, daily frequency, and exact alert times"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <!-- Medication Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Medication Name"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/et_dialog_med_name"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:hint="e.g. Metformin, Amlodipine, Paracetamol"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp"
            android:background="@drawable/bg_edit_text" />

        <!-- Schedule Start Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Prescription Start Date"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_elevated"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_dialog_start_date_val"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Today (Starts Immediately)"
                android:textColor="@color/teal_accent"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_dialog_pick_start_date"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="10dp"
                android:text="📅 Pick Date"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Daily Frequency Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="How Many Times Per Day?"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <Spinner
            android:id="@+id/spinner_dialog_frequency"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:paddingHorizontal="12dp"
            android:background="@drawable/bg_edit_text" />

        <!-- Individual Dose Time Pickers Container -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Set Notification Alarm Time for Each Dose:"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/teal_accent" />

        <!-- Dose Time 1 -->
        <LinearLayout
            android:id="@+id/layout_time_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_elevated"
            android:padding="10dp">

            <TextView
                android:id="@+id/tv_label_dose_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dose 1 Time:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_time_val_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="08:00 AM"
                android:textColor="@color/teal_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pick_time_1"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="10dp"
                android:text="🕒 Set Time"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dose Time 2 -->
        <LinearLayout
            android:id="@+id/layout_time_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_elevated"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_dose_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dose 2 Time:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_time_val_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="02:00 PM"
                android:textColor="@color/teal_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pick_time_2"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="10dp"
                android:text="🕒 Set Time"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dose Time 3 -->
        <LinearLayout
            android:id="@+id/layout_time_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_elevated"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_dose_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dose 3 Time:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_time_val_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="08:00 PM"
                android:textColor="@color/teal_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pick_time_3"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="10dp"
                android:text="🕒 Set Time"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dose Time 4 -->
        <LinearLayout
            android:id="@+id/layout_time_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_elevated"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_label_dose_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dose 4 Time:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_time_val_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="10:00 PM"
                android:textColor="@color/teal_accent"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_pick_time_4"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="10dp"
                android:text="🕒 Set Time"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
