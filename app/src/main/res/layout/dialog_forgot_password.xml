<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_dark"
    android:padding="22dp">

    <!-- Header with Key Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_icon"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔑"
                android:textSize="20sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Account Password"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify your email and set a new password of your choice"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#374151"
        android:layout_marginBottom="14dp" />

    <!-- Registered Email Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registered Email Address"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_reset_email"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_edit_text"
        android:hint="name@example.com"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:inputType="textEmailAddress" />

    <!-- New Password Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="New Password"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_reset_new_pin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Enter password of your choice"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:inputType="textPassword" />

    <!-- Confirm Password Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Confirm New Password"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_reset_confirm_pin"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_edit_text"
        android:hint="Re-enter password"
        android:textColorHint="@color/text_muted"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:paddingHorizontal="14dp"
        android:inputType="textPassword" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp"
        android:gravity="end">

        <Button
            android:id="@+id/btn_reset_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_reset_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Reset &amp; Save Password"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:paddingHorizontal="18dp"
            android:background="@drawable/bg_button_teal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#374151"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="12dp" />

    <!-- Google Fast Recovery Shortcut -->
    <LinearLayout
        android:id="@+id/btn_reset_via_google"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_google_logo"
            android:contentDescription="Google"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign in directly with Google instead"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/teal_accent" />
    </LinearLayout>

</LinearLayout>
