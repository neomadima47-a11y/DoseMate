<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="2dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/layout_day_cell_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_card_elevated"
        android:padding="2dp">

        <TextView
            android:id="@+id/tv_day_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_day_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="✓"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/health_green"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1dp" />
    </LinearLayout>

</LinearLayout>
