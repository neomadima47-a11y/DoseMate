<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_card_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_log_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="📊"
            android:textSize="16sp"
            android:background="@drawable/bg_circle_icon"
            android:layout_marginEnd="10dp" />

        <TextView
            android:id="@+id/tv_log_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Blood Pressure"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_log_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today, 09:30 AM"
            android:textSize="12sp"
            android:textColor="@color/text_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_log_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="120/80 mmHg"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/teal_accent" />

        <TextView
            android:id="@+id/tv_log_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Normal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/health_green"
            android:background="@drawable/bg_badge_green"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_log_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Felt calm, resting for 5 minutes before reading."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:background="@drawable/bg_card_elevated"
        android:padding="8dp" />

</LinearLayout>
